{
  "$comment": "Word parity contract overrides. Generator (generate-manifest.cjs) merges these over the census ledger (key = the row's wo.match binding id, lowercased — e.g. 'bold' — or its feature id — e.g. 'table.table'). Entry fields: effektClass format|structure|dialog|op|view|stub|covered-cluster; selector: WO control selector (fallback: [data-cmd=<wo>] then #btn-<wo>); pre: prerequisite action ('file-menu' opens the File menu first); assertion: {kind: computed-style|dom-mutation|dialog-visible|op-emitted|viewport-flag, ...}; subFeatures: [{name, selector}] — dialog-visible entries MUST list them, every missing one is a FAIL; xfail: true marks a known gap (reported, non-gating); note: free text.",
  "entries": {
    "bold": {
      "effektClass": "format",
      "selector": "[data-cmd=\"bold\"]",
      "assertion": {
        "kind": "computed-style",
        "prop": "font-weight",
        "equals": "700"
      }
    },
    "italic": {
      "effektClass": "format",
      "selector": "[data-cmd=\"italic\"]",
      "assertion": {
        "kind": "computed-style",
        "prop": "font-style",
        "equals": "italic"
      }
    },
    "table.table": {
      "effektClass": "structure",
      "woTab": "insert",
      "selector": "#btn-table",
      "assertion": {
        "kind": "dom-mutation",
        "selector": "#editor table"
      },
      "post": "#btn-table-ok"
    },
    "protect.encrypt": {
      "effektClass": "dialog",
      "selector": "[data-cmd=\"protectDialog\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#protect-dialog"
      },
      "subFeatures": [
        {
          "name": "restrict toggle",
          "selector": "#protect-check-restrict"
        },
        {
          "name": "password input",
          "selector": "#protect-new-password"
        },
        {
          "name": "apply action",
          "selector": "#btn-protect-apply"
        }
      ],
      "woTab": "protection"
    },
    "formatting.paragraph-line-spacing": {
      "effektClass": "dialog",
      "xfail": true,
      "note": "KNOWN GAP: OO's line-spacing entry leads to a ParagraphSettings dialog (alignment/indent/spacing/widow control). WO only has a line-height select — no dialog exists. Full OO ParagraphSettings lives in the right panel, which the census walk does not capture.",
      "selector": "#line-spacing",
      "assertion": {
        "kind": "dialog-visible"
      },
      "subFeatures": [
        {
          "name": "spacing before/after numeric",
          "selector": "[name=spacing-before]"
        },
        {
          "name": "first-line indent",
          "selector": "[name=first-line]"
        },
        {
          "name": "widow/orphan control",
          "selector": "[name=widow]"
        }
      ]
    },
    "info": {
      "effektClass": "dialog",
      "selector": "#btn-fileinfo",
      "pre": "backstage:info",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#info-dialog"
      },
      "subFeatures": [
        {
          "name": "document name",
          "selector": "#info-name"
        },
        {
          "name": "document path",
          "selector": "#info-path"
        },
        {
          "name": "language",
          "selector": "#info-lang"
        },
        {
          "name": "word/char stats",
          "selector": "#info-stats"
        },
        {
          "name": "file size",
          "selector": "#info-size"
        }
      ]
    },
    "toggledropcap": {
      "effektClass": "dialog",
      "selector": "[data-cmd=\"toggleDropcap\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#dropcap-dialog"
      },
      "subFeatures": [
        {
          "name": "position select",
          "selector": "#dropcap-position"
        },
        {
          "name": "lines",
          "selector": "#dropcap-lines"
        },
        {
          "name": "distance",
          "selector": "#dropcap-distance"
        },
        {
          "name": "apply action",
          "selector": "#btn-dropcap-ok"
        }
      ],
      "woTab": "insert",
      "note": "ledger row: insert.drop-cap"
    },
    "togglelinenumbers": {
      "effektClass": "dialog",
      "selector": "[data-cmd=\"toggleLineNumbers\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#linenumbers-dialog"
      },
      "subFeatures": [
        {
          "name": "mode select",
          "selector": "#ln-mode"
        },
        {
          "name": "apply action",
          "selector": "#btn-linenumbers-ok"
        }
      ],
      "woTab": "layout",
      "note": "ledger row: page.line-numbers"
    },
    "togglewatermark": {
      "effektClass": "dialog",
      "selector": "[data-cmd=\"toggleWatermark\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#watermark-dialog"
      },
      "subFeatures": [
        {
          "name": "mode select",
          "selector": "#wm-mode"
        },
        {
          "name": "custom text",
          "selector": "#wm-text"
        },
        {
          "name": "color",
          "selector": "#wm-color"
        },
        {
          "name": "apply action",
          "selector": "#btn-watermark-ok"
        }
      ],
      "woTab": "layout",
      "note": "ledger row: page.watermark"
    },
    "togglehyphenation": {
      "effektClass": "dialog",
      "selector": "[data-cmd=\"toggleHyphenation\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#hyphenation-dialog"
      },
      "subFeatures": [
        {
          "name": "mode select",
          "selector": "#hy-mode"
        },
        {
          "name": "apply action",
          "selector": "#btn-hyphenation-ok"
        }
      ],
      "woTab": "layout",
      "note": "ledger row: page.hyphenation-options"
    },
    "multilevel": {
      "effektClass": "dialog",
      "selector": "[data-cmd=\"multilevel\"]",
      "assertion": {
        "kind": "dom-mutation",
        "selector": "#editor li li"
      },
      "woTab": "home",
      "note": "ledger row: formatting.multilevel-list — ribbon button nests the caret li under its previous sibling (direct DOM op, not a dialog); bullets-numbering-dialog lives on the list ctx menu",
      "pre": "list"
    },
    "file.view": {
      "effektClass": "dialog",
      "selector": ".ribbon-page[data-tab=\"view\"] [data-cmd=\"displayMode\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#displaymode-dialog"
      },
      "subFeatures": [
        {
          "name": "mode select",
          "selector": "#displaymode-mode"
        },
        {
          "name": "apply action",
          "selector": "#btn-displaymode-ok"
        }
      ],
      "woTab": "view",
      "note": "ledger row: file.view"
    },
    "review.display-mode": {
      "effektClass": "dialog",
      "selector": ".ribbon-page[data-tab=\"collaboration\"] [data-cmd=\"displayMode\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#displaymode-dialog"
      },
      "subFeatures": [
        {
          "name": "mode select",
          "selector": "#displaymode-mode"
        },
        {
          "name": "apply action",
          "selector": "#btn-displaymode-ok"
        }
      ],
      "woTab": "collaboration",
      "note": "ledger row: review.display-mode"
    }
  }
}
