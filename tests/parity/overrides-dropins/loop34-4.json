{"$comment": "WO034-4: promote 6 retargeted rows (cls dialog) — react-port contract specs for dialoginput entries extracted from di-insert.json and di-ctx-list.json. cls = context-level + legacy DOM surface. All 6 are dialog-level contracts promoted for the React canvas editor lane.", "entries": {"dialoginput.drop-cap-settings": {"effektClass": "dialog", "pre": "ctx-menu", "selector": "[data-ctx=\"DropcapSettings\"]", "contract": {"selector": "#btn-insert-drop-cap", "assertion": {"kind": "dom-mutation", "selector": "[data-wo-right-panel=\"paragraph\"]"}, "pre": "", "woTab": "insert", "xfail": false, "note": "loop34-4 react-port: #btn-insert-drop-cap opens Paragraph right panel (dropCap -> paragraph)."}, "assertion": {"kind": "dialog-input", "set": [{"selector": "#dropcap-position", "value": "in-margin"}, {"selector": "#dropcap-lines", "value": "4"}], "click": "#btn-dropcap-ok", "expect": {"selector": "#editor span.dropcap.in-margin[style*=\"--drop-lines: 4\"]"}}, "note": "dialoginput depth: position=in-margin + lines=4 -> span.dropcap.in-margin with --drop-lines: 4"}, "dialoginput.dropcap": {"effektClass": "dialog", "woTab": "insert", "selector": "button[data-cmd=\"toggleDropcap\"]", "contract": {"selector": "#btn-insert-drop-cap", "assertion": {"kind": "dom-mutation", "selector": "[data-wo-right-panel=\"paragraph\"]"}, "pre": "", "woTab": "insert", "xfail": false, "note": "loop34-4 react-port: #btn-insert-drop-cap opens Paragraph panel."}, "assertion": {"kind": "dialog-input", "set": [{"selector": "#dropcap-position", "value": "dropped"}, {"selector": "#dropcap-lines", "value": "3"}, {"selector": "#dropcap-distance", "value": "0"}], "click": "#btn-dropcap-ok", "expect": {"selector": "#editor span.dropcap"}}, "note": "insert.drop-cap depth: confirmDropcapDialog -> applyDropcap -> span.dropcap"}, "dialoginput.contentcontrol": {"effektClass": "dialog", "woTab": "insert", "selector": "#btn-contentcontrol", "contract": {"selector": "#btn-insert-content-control", "assertion": {"kind": "dom-visible", "selector": "[role=\"menu\"], [role=\"listbox\"]"}, "pre": "", "woTab": "insert", "xfail": false, "note": "loop34-4 react-port: #btn-insert-content-control opens the content controls dropdown menu."}, "assertion": {"kind": "dialog-input", "set": [{"selector": "#cc-type", "value": "checkbox"}, {"selector": "#cc-title", "value": "L2J-02 cc"}], "click": "#btn-cc-ok", "expect": {"selector": "#editor span.content-control[data-cc=\"checkbox\"]"}}, "note": "insert.content-controls depth: btn-cc-ok -> span.content-control[data-cc=checkbox]"}, "dialoginput.equation": {"effektClass": "dialog", "woTab": "insert", "selector": "#btn-equation", "contract": {"selector": "#btn-insert-equation", "assertion": {"kind": "dom-mutation", "selector": "[data-wo-right-panel=\"plugins\"]"}, "pre": "", "woTab": "insert", "xfail": false, "note": "loop34-4 react-port: #btn-insert-equation opens Plugins panel."}, "assertion": {"kind": "dialog-input", "set": [{"selector": "#equation-input", "value": "x^2"}], "click": "#btn-equation-ok", "expect": {"selector": "#editor img.vector-object[data-kind=\"equation\"]"}}, "note": "insert.equation depth: x^2 -> img.vector-object[data-kind=equation]"}, "dialoginput.symbol": {"effektClass": "dialog", "woTab": "insert", "selector": "#btn-symbol", "contract": {"selector": "#btn-insert-symbol", "assertion": {"kind": "dom-mutation", "selector": "[data-wo-right-panel=\"plugins\"]"}, "pre": "", "woTab": "insert", "xfail": false, "note": "loop34-4 react-port: #btn-insert-symbol opens Plugins panel."}, "assertion": {"kind": "dialog-input", "set": [{"selector": "#symbol-range", "value": "391-3ce"}], "click": ".symbol-grid button.symbol-btn", "dialog": "#symbol-dialog"}, "note": "insert.symbol depth: range 391-3ce, first Greek glyph click"}, "dialoginput.shape": {"effektClass": "dialog", "woTab": "insert", "selector": "button[data-cmd=\"insertObject\"][data-value=\"shape\"]", "contract": {"selector": "#btn-insert-shape", "assertion": {"kind": "dom-mutation", "selector": "[data-wo-right-panel=\"shape\"]"}, "pre": "", "woTab": "insert", "xfail": false, "note": "loop34-4 react-port: #btn-insert-shape opens Shape panel."}, "assertion": {"kind": "dialog-input", "set": [], "click": [".shape-option[data-shape-type=\"rectangle\"]", "#btn-shape-ok"], "expect": {"selector": "#editor div.object.drawing-shape[data-shape]"}}, "note": "shape picker: select rectangle then ok."}}}
