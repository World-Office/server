      "woTab": "insert",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#symbol-dialog"
      },
      "subFeatures": [
        { "name": "font select", "selector": "#symbol-font" },
        { "name": "range select", "selector": "#symbol-range" },
        { "name": "symbol grid", "selector": "#symbol-grid" },
        { "name": "close action", "selector": "#btn-symbol-close" }
      ],
      "note": "ledger row: insert.more-symbols — OO reaches the Symbol dialog from the equation gallery's More symbols item; WO's gallery ships no More-symbols entry (census matched the Symbols ▸ trigger instead) — the dialog is one hop away via the adjacent Ω button, #btn-symbol → openSymbolDialog → #symbol-dialog"
    },
    "file.file": {
      "effektClass": "dialog",
      "selector": "#btn-textfile",
      "woTab": "insert",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#textfromfile-dialog"
      },
      "subFeatures": [
        { "name": "file input", "selector": "#textfromfile-input" },
        { "name": "insertion mode", "selector": "#textfromfile-mode" },
        { "name": "format select", "selector": "#textfromfile-format" },
        { "name": "insert action", "selector": "#btn-textfromfile-insert" },
        { "name": "cancel action", "selector": "#btn-textfromfile-cancel" }
      ],
      "note": "ledger row: file.file — insert-tab Text from File button opens #textfromfile-dialog (editor.js:12829 openDlg), not a native picker"
    },
    "file.save": {
      "effektClass": "op",
      "pre": "backstage:save",
      "selector": "[data-cmd=\"saveDocument\"]",
      "assertion": {
        "kind": "text-mutation",
        "selector": "#status",
        "contains": "Saved"
      },
      "note": "ledger row: file.save — backstage Save pane's primary button routes saveDocument() (editor.js:1429, 630); successful POST api(save) flips the status bar to Status.Saved \"Saved ✓\""
    },
    "file.back": {
      "effektClass": "view",
      "pre": "backstage:info",
      "selector": "[data-cmd=\"closeFileMenu\"]",
      "assertion": {
        "kind": "viewport-flag",
        "rootSelector": "#backstage-overlay",
        "attr": "class",
        "equals": "backstage-overlay"
      },
      "note": "ledger row: file.back — backstage Back row routes closeFileMenu → closeBackstage → hideBackstage which removes the .open class from #backstage-overlay (editor.js:1266, 10503-10508)"
    }
