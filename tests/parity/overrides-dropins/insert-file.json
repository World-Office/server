    "insert.symbols": {
      "effektClass": "dialog",
      "selector": "[data-i18n=\"Insert.EquationGallery\"]",
      "woTab": "insert",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "[data-wo-id=\"btn-equation\"] .menu-list"
      },
      "subFeatures": [
        { "name": "fractions family", "selector": "[data-value=\"fractions\"]" },
        { "name": "scripts family", "selector": "[data-value=\"scripts\"]" },
        { "name": "radicals family", "selector": "[data-value=\"radicals\"]" },
        { "name": "integrals family", "selector": "[data-value=\"integrals\"]" },
        { "name": "large operators family", "selector": "[data-value=\"large-operators\"]" },
        { "name": "brackets family", "selector": "[data-value=\"brackets\"]" },
        { "name": "functions family", "selector": "[data-value=\"functions\"]" },
        { "name": "accents family", "selector": "[data-value=\"accents\"]" },
        { "name": "limits family", "selector": "[data-value=\"limits-and-logarithms\"]" },
        { "name": "operators family", "selector": "[data-value=\"operators\"]" },
        { "name": "matrices family", "selector": "[data-value=\"matrices\"]" }
      ],
      "note": "ledger row: insert.symbols — the insert-tab Symbols ▾ menu-trigger (editor.js .rb-menu wiring, setMenu) discloses the equation gallery menu-list carrying all 11 template families"
    },
    "insert.fractions": {
      "effektClass": "structure",
      "pre": "menu:[data-i18n=\"Insert.EquationGallery\"]",
      "selector": "[data-cmd=\"equationTemplate\"][data-value=\"fractions\"]",
      "woTab": "insert",
      "assertion": {
        "kind": "dom-mutation",
        "selector": "#editor img[data-kind=\"equation\"]"
      },
      "note": "ledger row: insert.fractions — gallery Fractions row dispatches equationTemplate(\"fractions\") → insertEquationTemplate → insertVectorObject renders img.vector-object[data-kind=equation] into #editor (editor.js:1548, 2359, 13072)"
