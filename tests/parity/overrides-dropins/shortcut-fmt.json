  "shortcut.movetonextcell": {
   "key": "Tab",
   "pre": "in-table",
   "effektClass": "structure",
   "assertion": {
    "kind": "selection-moved"
   },
   "note": "Tab in table cell -> next cell (MoveToNextCell)"
