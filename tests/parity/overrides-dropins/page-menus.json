{
  "entries": {
    "page.normal": {
      "effektClass": "op",
      "woTab": "layout",
      "pre": "menu:[data-i18n=\"Layout.Margins\"]",
      "selector": "[data-cmd=\"applyPageMargins\"][data-value=\"normal\"]",
      "assertion": {
        "kind": "dom-mutation",
        "selector": ".page-setup[data-margin-top=\"1440\"][data-margin-left=\"1440\"]"
      },
      "note": "ledger row: page.normal — Margins ▾ Normal writes PS_MARGIN_PRESETS.normal (t/b/l/r 1440 twips) onto the .page-setup marker (editor.js applyPageMarginsPreset)"
    },
    "page.custom-margins": {
      "effektClass": "dialog",
      "woTab": "layout",
      "pre": "menu:[data-i18n=\"Layout.Margins\"]",
      "selector": "[data-i18n=\"Layout.Margins.Custom\"]",
      "assertion": {
        "kind": "dialog-visible",
        "dialogSelector": "#page-setup-dialog"
      },
      "subFeatures": [
        { "name": "page size select", "selector": "#ps-size" },
        { "name": "margin top", "selector": "#ps-mt" },
        { "name": "margin bottom", "selector": "#ps-mb" },
        { "name": "margin left", "selector": "#ps-ml" },
        { "name": "margin right", "selector": "#ps-mr" },
        { "name": "apply action", "selector": "#btn-ps-apply" }
      ],
      "note": "ledger row: page.custom-margins — Margins ▾ 'Custom margins' item (data-cmd=openPageSetup) opens the same #page-setup-dialog as the visible Page setup ribbon button"
    },
    "page.last-custom": {
      "effektClass": "op",
      "woTab": "layout",
      "pre": "menu:[data-i18n=\"Layout.Margins\"]",
      "selector": "[data-cmd=\"applyPageMargins\"][data-value=\"last-custom\"]",
      "assertion": {
        "kind": "dom-mutation",
        "selector": ".page-setup[data-margin-top]"
      },
      "xfail": true,
      "note": "ledger row: page.last-custom — honest gap: re-applying the stored custom margins (localStorage wo-last-custom-margins, editor.js readCustomMargins) needs prior dialog state the runner pre vocabulary cannot seed; on a fresh page the item is a documented no-op ('No custom margins yet' status only, no marker write)"
    },
