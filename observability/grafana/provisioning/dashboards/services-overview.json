{
  "title": "World Office — Services Overview",
  "uid": "world-office-services",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["world-office", "services"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "panels": [
    {
      "title": "Service Health",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "up{job=~\"api-gateway|identity-service|storage-service|conversion-service|coauthoring-service|session-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "value": "1", "text": "UP", "color": "green" },
            { "type": "value", "value": "0", "text": "DOWN", "color": "red" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "title": "HTTP Request Rate (last 1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Error Rate (last 1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=~\"api-gateway|identity-service|storage-service|conversion-service|coauthoring-service|session-service\"} / 1024 / 1024",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "CPU Usage (cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=~\"api-gateway|identity-service|storage-service|conversion-service|coauthoring-service|session-service\"}[5m])",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Coauthoring — Active Sessions",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "id": 3,
      "targets": [
        {
          "expr": "sessions_active",
          "legendFormat": "Active sessions",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        }
      }
    },
    {
      "title": "Coauthoring — Connection Refused",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(connection_refused_total[5m])",
          "legendFormat": "Refused/min",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "query": "label_values(up, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" }
}
