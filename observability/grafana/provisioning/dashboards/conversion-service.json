{
  "title": "World Office — Conversion Service",
  "uid": "world-office-conversion",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["world-office", "conversion"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "panels": [
    {
      "title": "Conversions Per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "rate(conversions_total[5m])",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "Conversion Duration P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(conversion_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(conversion_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(conversion_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "Conversion Success Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(conversions_total{status=\"success\"}[5m])) / sum(rate(conversions_total[5m])) * 100",
          "legendFormat": "success %",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "avg"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Active Conversions",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "conversions_in_progress",
          "legendFormat": "in progress",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "value": 4, "color": "yellow" },
              { "value": 8, "color": "red" }
            ]
          }
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
